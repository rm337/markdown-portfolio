  roundedRect(-50,-34,100,68,7,'#1b2126');roundedRect(-40,-24,80,48,3,'#080b0e');ctx.fillStyle='#cc8c44';ctx.font='bold 11px Arial';ctx.textAlign='center';ctx.fillText('FRIED',0,4);ctx.restore();
  roundedRect(W*.7,H*.57,W*.13,H*.085,5,'#232a30');roundedRect(W*.71,H*.58,W*.11,H*.062,2,'#0a1218');ctx.fillStyle='#6e91ad';ctx.font='bold 9px Arial';ctx.textAlign='center';ctx.fillText('BACKUP',W*.765,H*.615);
 }
 scorchMarks.forEach(s=>{const g=ctx.createRadialGradient(s.x,s.y,5,s.x,s.y,s.r);g.addColorStop(0,'rgba(25,20,17,.78)');g.addColorStop(.55,'rgba(37,29,24,.42)');g.addColorStop(1,'rgba(37,29,24,0)');ctx.fillStyle=g;ctx.beginPath();ctx.arc(s.x,s.y,s.r,0,Math.PI*2);ctx.fill()});
 spills.forEach(s=>{const g=ctx.createRadialGradient(s.x,s.y,3,s.x,s.y,s.r);g.addColorStop(0,'rgba(96,55,34,.75)');g.addColorStop(1,'rgba(96,55,34,0)');ctx.fillStyle=g;ctx.beginPath();ctx.ellipse(s.x,s.y,s.r,s.r*.55,0,0,Math.PI*2);ctx.fill()});
}
