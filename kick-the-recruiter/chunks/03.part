.down)return;pointer.down=false;
 if(grabbed?.type==='body'){grabbed.obj.addImpulse(pointer.vx*.025,pointer.vy*.025)}
 if(grabbed?.type==='prop'){
  const p=grabbed.obj;p.drag=false;p.thrown=true;p.vx=pointer.vx*.75;p.vy=pointer.vy*.75;p.vr=(pointer.vx*.012)+(Math.random()-.5)*5;
 }
 grabbed=null;
 scheduleRecovery(2400);
});

function simulate(dt){
 if(frozen)return;
 dt*=slowMo?.28:1;
 const g=(lowGrav?180:650);
 for(const p of Object.values(P)){
  if(p===grabbed?.obj)continue;
  if(p.pin){p.x=p.pin.x;p.y=p.pin.y;p.px=p.x;p.py=p.y;continue}
  const vx=(p.x-p.px)*.985,vy=(p.y-p.py)*.985;
  p.px=p.x;p.py=p.y;p.x+=vx;p.y+=vy+g*dt*dt;
  if(p.x<p.rad){p.x=p.rad;p.px=p.x+vx*.35}
  if(p.x>W-p.rad){p.x=W-p.rad;p.px=p.x+vx*.35}
  const floor=H-34;
  if(p.y>floor-p.rad){p.y=floor-p.rad;p.py=p.y+vy*.18}
  if(p.y<p.rad){p.y=p.rad;p.py=p.y+vy*.2}
 }
 for(let k=0;k<6;k++)sticks.forEach(s=>s.solve());

 ensurePropPos();
 for(const p of props){
  if(p.used||p.drag)continue;
  if(p.thrown){
    trails.push({x:p.px+p.w/2,y:p.py+p.h/2,life:.22,size:Math.max(3,Math.min(7,p.w*.08))});
  }
  p.vy+=g*dt;
  p.px+=p.vx*dt;p.py+=p.vy*dt;
  p.rot+=p.vr;
  p.vx*=.992;p.vy*=.995;p.vr*=.994;
  if(p.py+p.h>H-28){
    p.py=H-28-p.h;
    if(Math.abs(p.vy)>65){addParticle(p.px+p.w/2,p.py+p.h,4);addImpactRing(p.px+p.w/2,p.py+p.h,10)}
    p.vy*=-.42;p.vx*=.78;p.vr*=.82;
    if(Math.abs(p.vy)<35){p.thrown=false;p.vy=0}
  }
  if(p.px<0){p.px=0;p.vx*=-.48;p.vr*=-.7}
  if(p.px+p.w>W){p.px=W-p.w;p.vx*=-.48;p.vr*=-.7}
  const cx=p.px+p.w/2,cy=p.py+p.h/2;
  const candidates=[P.head,P.chest,P.hip,P.shL,P.shR,P.elL,P.elR,P.kneeL,P.kneeR];
  let closest=999,hitPoint=null;
  for(const bp of candidates){const d=Math.hypot(cx-bp.x,cy-bp.y);if(d<closest){closest=d;hitPoint=bp}}
  if(p.thrown && closest < Math.max(42,Math.min(72,(p.w+p.h)*.42)) && Math.hypot(p.vx,p.vy)>120){
    const mag=Math.min(48,Math.hypot(p.vx,p.vy)*.055);
    const len=Math.hypot(p.vx,p.vy)||1;
    hitPoint.addImpulse((p.vx/len)*mag,(p.vy/len)*mag);
    applyPropImpact(p,cx);
  }
 }
 particles.forEach(q=>{q.vy+=600*dt;q.x+=q.vx*dt;q.y+=q.vy*dt;q.life-=dt});
 particles=particles.filter(q=>q.life>0);
 trails.forEach(t=>t.life-=dt);trails=trails.filter(t=>t.life>0);
 impactRings.forEach(r=>{r.life-=dt;r.r+=90*dt});impactRings=impactRings.filter(r=>r.life>0);
 actionFx.forEach(a=>a.age+=dt);actionFx=actionFx.filter(a=>a.age<a.life);
}

function roundedRect(x,y,w,h,r,fill,stroke){
 ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fillStyle=fill;ctx.fill();
 if(stroke){ctx.strokeStyle=stroke;ctx.stroke()}
}
function limb(a,b,width,c1,c2){
 const dx=b.x-a.x,dy=b.y-a.y,L=Math.hypot(dx,dy),ang=Math.atan2(dy,dx);
 ctx.save();ctx.translate(a.x,a.y);ctx.rotate(ang);ctx.lineCap='round';
 const gr=ctx.createLinearGradient(0,-width/2,0,width/2);gr.addColorStop(0,c1);gr.addColorStop(1,c2);
 ctx.strokeStyle=gr;ctx.lineWidth=width;ctx.beginPath();ctx.moveTo(0,0);ctx.lineTo(L,0);ctx.stroke();ctx.restore()
}
