 ctx.beginPath();ctx.moveTo(P.shL.x,P.shL.y);ctx.lineTo(P.shR.x,P.shR.y);ctx.lineTo(P.hip.x+48,P.hip.y);ctx.lineTo(P.hip.x-48,P.hip.y);ctx.closePath();
 const tg=ctx.createLinearGradient(P.shL.x,P.chest.y,P.shR.x,P.chest.y);tg.addColorStop(0,'#22313f');tg.addColorStop(.52,'#34485a');tg.addColorStop(1,'#1f2c37');ctx.fillStyle=tg;ctx.fill();
 // shirt + tie
 ctx.fillStyle='#eef2f4';ctx.beginPath();ctx.moveTo(P.chest.x-20,P.shL.y+7);ctx.lineTo(P.chest.x+20,P.shR.y+7);ctx.lineTo(P.chest.x+12,P.hip.y-14);ctx.lineTo(P.chest.x-12,P.hip.y-14);ctx.closePath();ctx.fill();
 ctx.fillStyle='#26384a';ctx.beginPath();ctx.moveTo(P.chest.x,P.shL.y+8);ctx.lineTo(P.chest.x+9,P.shL.y+22);ctx.lineTo(P.chest.x+5,P.hip.y-18);ctx.lineTo(P.chest.x-5,P.hip.y-18);ctx.lineTo(P.chest.x-9,P.shL.y+22);ctx.closePath();ctx.fill();

 if(tornSuit>0){
   ctx.strokeStyle='rgba(20,23,26,.9)';ctx.lineWidth=3;
   ctx.beginPath();ctx.moveTo(P.chest.x-34,P.chest.y+18);ctx.lineTo(P.chest.x-12,P.chest.y+31);ctx.lineTo(P.chest.x-28,P.chest.y+42);ctx.stroke();
   if(tornSuit>1){ctx.beginPath();ctx.moveTo(P.chest.x+16,P.chest.y+40);ctx.lineTo(P.chest.x+38,P.chest.y+54);ctx.stroke();}
   if(tornSuit>2){ctx.beginPath();ctx.moveTo(P.chest.x-8,P.chest.y+67);ctx.lineTo(P.chest.x+14,P.chest.y+79);ctx.stroke();}
 }
 if(damage>28){
   ctx.fillStyle='rgba(40,34,31,.16)';ctx.beginPath();ctx.ellipse(P.chest.x-28,P.chest.y+52,18,32,-.4,0,Math.PI*2);ctx.fill();
 }

