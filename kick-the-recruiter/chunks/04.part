 // hands
 for(const h of [P.handL,P.handR]){
  const g=ctx.createRadialGradient(h.x-5,h.y-6,2,h.x,h.y,18);g.addColorStop(0,'#dda989');g.addColorStop(1,'#a96f57');ctx.fillStyle=g;ctx.beginPath();ctx.ellipse(h.x,h.y,16,19,0,0,Math.PI*2);ctx.fill()
 }
 // torso polygon
