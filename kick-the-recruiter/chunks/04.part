,Math.max(10,p.w*.45*shadowScale),Math.max(4,p.h*.12*shadowScale),0,0,Math.PI*2);ctx.fill();
 ctx.restore();

 ctx.save();
 ctx.translate(x+p.w/2,y+p.h/2);
 ctx.rotate(p.rot);
 ctx.translate(-(x+p.w/2),-(y+p.h/2));
 ctx.shadowColor='rgba(0,0,0,.45)';ctx.shadowBlur=p.thrown?12:6;ctx.shadowOffsetY=p.thrown?8:4;
 switch(p.kind){
  case'coffee':
   roundedRect(x,y,p.w-6,p.h,5,'#eceae6','#d7d7d2');ctx.strokeStyle='#eae8e4';ctx.lineWidth=4;ctx.beginPath();ctx.arc(x+p.w-5,y+15,8,-Math.PI/2,Math.PI/2);ctx.stroke();ctx.fillStyle='#5c321f';ctx.beginPath();ctx.ellipse(x+(p.w-6)/2,y+4,12,3,0,0,Math.PI*2);ctx.fill();break;
  case'stapler':roundedRect(x,y,p.w,p.h,8,'#20272d');ctx.fillStyle='#69747c';ctx.fillRect(x+4,y+p.h-5,p.w-8,5);break;
  case'phone':roundedRect(x,y,p.w,p.h,7,'#242b31');ctx.lineWidth=7;ctx.strokeStyle='#394249';ctx.beginPath();ctx.arc(x+p.w/2,y,18,.2,Math.PI-.2);ctx.stroke();break;
  case'keyboard':roundedRect(x,y,p.w,p.h,4,'#20262a');ctx.strokeStyle='#56616a';ctx.lineWidth=1;for(let i=8;i<p.w-8;i+=12){ctx.beginPath();ctx.moveTo(x+i,y+5);ctx.lineTo(x+i,y+p.h-5);ctx.stroke()}break;
  case'folder':roundedRect(x,y,p.w,p.h,4,'#d39a1d');ctx.fillStyle='#e2ac30';ctx.fillRect(x+5,y-8,28,10);break;
  case'clipboard':roundedRect(x,y,p.w,p.h,4,'#a98a65');roundedRect(x+17,y-5,24,11,3,'#66717a');ctx.fillStyle='#e8e2da';ctx.fillRect(x+9,y+16,p.w-18,p.h-24);break;
  case'bottle':roundedRect(x,y,p.w,p.h,7,'rgba(207,238,248,.8)','#d8edf5');ctx.fillStyle='#2f6d99';ctx.fillRect(x+5,y-7,p.w-10,8);break;
  case'plant':
   ctx.fillStyle='#8a4d29';ctx.beginPath();ctx.moveTo(x+10,y+36);ctx.lineTo(x+42,y+36);ctx.lineTo(x+36,y+64);ctx.lineTo(x+16,y+64);ctx.closePath();ctx.fill();
   ctx.fillStyle='#396d3f';for(const [ox,oy,rx,ry] of [[26,18,13,24],[12,22,14,10],[41,20,15,11],[25,5,10,18]]){ctx.beginPath();ctx.ellipse(x+ox,y+oy,rx,ry,0,0,Math.PI*2);ctx.fill()}break;
  case'trash':
   ctx.fillStyle='#626d74';ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x+p.w,y);ctx.lineTo(x+p.w-9,y+p.h);ctx.lineTo(x+9,y+p.h);ctx.closePath();ctx.fill();ctx.fillStyle='#808b91';ctx.fillRect(x-2,y-5,p.w+4,6);break;
 }
 ctx.restore()
}
function drawPerson(){
 // legs / arms first
 limb(P.hip,P.kneeL,34,'#21303c','#354757');limb(P.kneeL,P.footL,30,'#1d2933','#2c3b47');
 limb(P.hip,P.kneeR,34,'#21303c','#354757');limb(P.kneeR,P.footR,30,'#1d2933','#2c3b47');
 limb(P.shL,P.elL,31,'#263747','#3a4e60');limb(P.elL,P.handL,27,'#27394a','#40566a');
 limb(P.shR,P.elR,31,'#263747','#3a4e60');limb(P.elR,P.handR,27,'#27394a','#40566a');

 // shoes
